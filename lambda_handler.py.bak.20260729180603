    """Continue Sell Your Produce flow."""
    import re as _re

    def parse_kv(text):
        result = {}
        for line in text.strip().splitlines():
            if ":" in line:
                k, _, v = line.partition(":")
                result[k.strip().lower()] = v.strip()
        return result


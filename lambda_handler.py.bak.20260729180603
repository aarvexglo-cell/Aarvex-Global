        row_id = f"cat_{mode}_{idx}"
        rows.append({
            "id":          row_id,
            "title":       p[:24],
            "description": ("View details & request quote" if lang == "en" else "à¤µà¤¿à¤µà¤°à¤£ à¤µ à¤•à¥‹à¤Ÿ à¤¦à¥‡à¤–à¥‡à¤‚"),

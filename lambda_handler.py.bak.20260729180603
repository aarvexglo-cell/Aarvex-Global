    return False


def _validate_sample_quantity(qty: str) -> bool:
    m = re.search(r"(\d+(?:\.\d+)?)\s*(g|kg)", qty, re.IGNORECASE)
    if not m:
        return False
    val = float(m.group(1))
    unit = m.group(2).lower()
    grams = val if unit == "g" else val * 1000
    return 100 <= grams <= 1000



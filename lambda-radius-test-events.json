{
  "how_to_use": [
    "Deploy the latest marketplace.py first.",
    "In every event, replace __VALID_GOOGLE_ID_TOKEN__ with the signed-in tester's current Google ID token from browser localStorage key ax_google_token.",
    "Run the cases in the listed order. The two test accounts must have saved Personal Information map pins roughly 10–15 km apart, and both must have a public post, story, and one active KYC-approved shop/product.",
    "Each item below is a complete Lambda/API Gateway v2 event. Copy one event object at a time into the Lambda Test console."
  ],
  "expected": {
    "strict_radius": "At 5 km, the distant account must not appear in /geo/users, /feed, /story/list, /catalogue/sections, /catalogue/search, or /shop/list. At 10 km, it appears only if its permanent Personal Information pin is within 10 km.",
    "selected_exception": "A distant selected-audience post/story appears only when both users follow each other and the viewer is explicitly in audience_subs. Public and followers-only content remains radius-filtered.",
    "independent_sections": "GET /shops/top is city-based and does not change when 5 km/10 km changes. Favourites endpoints retain liked items outside the radius. GET /banner/active is unaffected by radius.",
    "address_sync": "After profile_update_address, GET /profile shows the new Personal Information address/pin; the user's shop uses the same address on its next public/profile response; re-running geo_set_10 centres the radius on the new pin."
  },

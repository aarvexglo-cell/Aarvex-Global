<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Aarvex Global — Premium Agri Export | Spices, Grains &amp; Produce</title>
  <!-- Command Center telemetry (client health → admin) -->
  <script>window.LAMBDA_URL='https://j1yound90m.execute-api.ap-southeast-1.amazonaws.com';window.AX_TAB_HINT='home';</script>
  <script src="ax-telemetry.js?v=3"></script>
  <script src="ax-error-log.js?v=3"></script>
  <meta name="description"
    content="Aarvex Global — certified agri import-export company. Buy premium spices, grains, pulses and fresh produce directly from verified Indian sellers. GSTIN, IEC &amp; Udyam registered.">
  <meta name="keywords"
    content="agri export India, spices exporter, grains wholesale, teja lal mirch, kashmiri mirch, basmati rice, onion export, agricultural marketplace, bulk produce">
  <meta name="robots" content="index, follow">
  <meta name="theme-color" content="#0A0A0A">
  <link rel="canonical" href="https://aarvexglobal.com/">
  <link rel="manifest" href="manifest.webmanifest">

  <!-- ── SEO: Open Graph (WhatsApp / Facebook / LinkedIn link previews) ── -->
  <meta property="og:type" content="website">

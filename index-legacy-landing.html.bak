  <meta name="twitter:description"
    content="Premium spices, grains &amp; produce from verified Indian sellers. Certified, export-grade, bulk-ready.">
  <meta name="twitter:image" content="https://aarvexglobal.com/assets/og-cover.jpg">

  <!-- ── SEO: structured data (Google rich results) ── -->
  <script type="application/ld+json">

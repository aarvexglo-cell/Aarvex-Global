    "address": { "@type": "PostalAddress", "addressRegion": "Maharashtra", "addressCountry": "IN" },
    "sameAs": []
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Aarvex Global",
    "url": "https://aarvexglobal.com/",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://aarvexglobal.com/?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  }
  </script>
  <link rel="icon" type="image/svg+xml" href="ax-icon.svg?v=4">
  <link rel="apple-touch-icon" href="ax-icon.svg?v=4">
  <link rel="apple-touch-icon" sizes="180x180" href="assets/apple-touch-icon.png?v=3">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700;9..144,800&family=Inter:wght@300;400;500;600;700&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="tokens.css?v=11">
  <link rel="stylesheet" href="catalogue-ui.css">
  <link rel="stylesheet" href="components.css">
  <script src="portal-polyfills.js"></script>
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <style>
    /* ─── TOKENS ─────────────────────────────────────────────────
       Color, font, radius, shadow & gradient tokens now live in
       tokens.css (shared with portal.html) — see legacy-alias
       section there for --earth/--leaf/--gold/etc. This block only
       keeps index.html's own golden-ratio spacing scale, which is
       local to this marketing page and not shared. ───────────── */
    :root {
      /* Golden-ratio spacing scale (φ ≈ 1.618) — index.html only */
      --s-1: 0.5rem;
      --s-2: 0.8rem;
      --s-3: 1.3rem;
      --s-4: 2.1rem;
      --s-5: 3.4rem;
      --s-6: 5.5rem;
      --s-7: 8.9rem;
    }

    /* ─── BASE ───────────────────────────────────── */
    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      font-size: 16px;
      -webkit-text-size-adjust: 100%;
    }

    body {
      font-family: var(--font-body);
      background: var(--cream);
      color: var(--text);
      line-height: 1.65;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }

    ::selection {
      background: rgba(46, 107, 65, .18);
      color: var(--earth);
    }

    img {
      max-width: 100%;
      display: block;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    button {
      cursor: pointer;
      border: none;
      font-family: inherit;
    }

    input,
    select,
    textarea {
      font-family: inherit;
    }

    /* ─── UTILITY ────────────────────────────────── */
    /* --container-pad drives .container's side padding AND the
       mobile hero-visual full-bleed breakout below (Section 0 #2 fix)
       so the two can never drift out of sync across breakpoints. */
    :root {
      --container-pad: 28px;
    }

    .container {
      max-width: 1180px;
      margin: 0 auto;
      padding: 0 var(--container-pad);
    }

    .section-title {
      font-family: var(--font-display);
      font-size: clamp(30px, 4.4vw, 46px);
      font-weight: 700;
      color: var(--earth);
      line-height: 1.12;
      letter-spacing: -.015em;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 11.5px;
      font-weight: 600;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: var(--leaf);
      background: rgba(46, 107, 65, .08);
      border: 1px solid rgba(46, 107, 65, .18);
      padding: 6px 15px;
      border-radius: 40px;
      margin-bottom: 18px;
    }

    .eyebrow i {
      font-size: 12px;
    }

    .btn-primary {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 9px;
      padding: 15px 30px;
      background: var(--gradient-leaf);
      background-size: 160% 160%;
      color: var(--white);
      font-size: 15px;
      font-weight: 600;
      border-radius: 50px;
      box-shadow: 0 8px 24px rgba(46, 107, 65, .28);
      transition: transform .25s cubic-bezier(.22, 1, .36, 1), box-shadow .25s, background-position .5s;
      white-space: nowrap;
    }

    .btn-primary:hover {
      transform: translateY(-3px);
      box-shadow: 0 14px 34px rgba(46, 107, 65, .4);
      background-position: 100% 0;
    }

    .btn-primary:active {
      transform: translateY(-1px);
    }

    .btn-outline {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      padding: 14px 28px;
      background: rgba(255, 255, 255, .04);
      color: var(--white);
      font-size: 15px;
      font-weight: 600;
      border: 1.5px solid rgba(255, 255, 255, .32);
      border-radius: 50px;
      transition: transform .25s cubic-bezier(.22, 1, .36, 1), background .25s, border-color .25s;
      white-space: nowrap;
      backdrop-filter: blur(6px);
    }

    .btn-outline:hover {
      background: rgba(255, 255, 255, .12);
      border-color: rgba(255, 255, 255, .65);
      transform: translateY(-3px);
    }

    .tag {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 4px 12px;
      border-radius: 30px;
      font-size: 12px;
      font-weight: 600;
    }

    /* ─── NAV ────────────────────────────────────── */
    .nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 1000;
      background: rgba(253, 250, 243, .92);
      backdrop-filter: blur(18px);
      border-bottom: 1px solid var(--border);
      transition: all .25s;
    }

    .nav.scrolled {
      box-shadow: 0 2px 20px rgba(26, 18, 8, .08);
    }

    .nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 60px;
      gap: 12px;
    }

    .nav-logo {
      display: flex;
      align-items: center;
      gap: 11px;
    }

    .nav-logo-badge {
      width: 44px;
      height: 44px;
      background: linear-gradient(150deg, #ffffff 0%, var(--mist) 100%);
      border-radius: 13px;
      display: grid;
      place-items: center;
      flex-shrink: 0;
      border: 1px solid var(--border);
      box-shadow: 0 4px 14px rgba(20, 48, 38, .12), inset 0 1px 0 rgba(255, 255, 255, .8);
      transition: transform .35s cubic-bezier(.22, 1, .36, 1), box-shadow .35s;
    }

    .nav-logo:hover .nav-logo-badge {
      transform: translateY(-1px) rotate(-3deg);
      box-shadow: 0 8px 20px rgba(20, 48, 38, .18), inset 0 1px 0 rgba(255, 255, 255, .8);
    }

    .nav-logo-badge img {
      width: 27px;
      height: auto;
      display: block;
    }

    .nav-logo-badge i {
      color: #fff;
      font-size: 18px;
    }

    .nav-logo-name {
      font-family: var(--font-display);
      font-size: 18px;
      font-weight: 800;
      color: var(--earth);
      letter-spacing: -.3px;
      line-height: 1;
    }

    .nav-logo-sub {
      font-size: 10px;
      font-weight: 500;
      color: var(--text3);
      letter-spacing: .06em;
    }

    .nav-links {
      display: none;
      align-items: center;
      gap: 4px;
      list-style: none;
    }

    .nav-toggle {
      display: none;
      background: none;
      border: none;
      cursor: pointer;
      color: var(--text2);
      padding: 8px;
      border-radius: 8px;
      flex-shrink: 0;
      align-items: center;
      justify-content: center;
    }

    .nav-toggle:hover {
      background: var(--mist);
      color: var(--leaf);
    }

    .nav-links a {
      padding: 8px 14px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 500;
      color: var(--text2);
      transition: all .15s;
    }

    .nav-links a:hover {
      background: var(--mist);
      color: var(--leaf);
    }

    .nav-cta {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .nav-social {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .nav-social a {
      width: 36px;
      height: 36px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: rgba(255, 255, 255, .08);
      color: var(--text2);
      border: 1px solid rgba(255, 255, 255, .08);
      transition: transform .2s, background .2s, color .2s;
    }

    .nav-social a:hover {
      background: rgba(255, 255, 255, .16);
      color: var(--leaf);
      transform: translateY(-1px);
    }

    .nav-social a i {
      font-size: 14px;
    }

    .nav-cta .nav-login-btn,
    .nav-cta .nav-whatsapp {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 18px;
      font-size: 13.5px;
      font-weight: 600;
      border-radius: 50px;
      white-space: nowrap;
      transition: transform .2s, border-color .2s, color .2s, background .2s, box-shadow .2s;
    }

    .nav-whatsapp {
      background: #25D366;
      color: #fff;
      box-shadow: 0 3px 14px rgba(37, 211, 102, .28);
    }

    .nav-whatsapp:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 22px rgba(37, 211, 102, .36);
    }

    .nav-login-btn {
      background: rgba(255, 255, 255, .1);
      color: var(--forest);
      border: 1.5px solid var(--border);
    }

    .nav-login-btn:hover {
      background: var(--mist);
      border-color: var(--leaf);
      color: var(--leaf);
      transform: translateY(-1px);
    }

    .nav-login-btn i {
      font-size: 13px;
      color: var(--leaf);
    }

    .nav-login-btn .nav-user-avatar {
      width: 26px;
      height: 26px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid var(--leaf);
    }

    .mobile-menu {
      display: none;
      position: fixed;
      top: 57px;
      left: 0;
      right: 0;
      bottom: 0;
      background: var(--cream);
      z-index: 999;
      /* bottom padding keeps the pinned My Account button clear of the
         screen edge / gesture bar on notched phones */
      padding: 24px 24px calc(24px + env(safe-area-inset-bottom, 0px));
      flex-direction: column;
      gap: 6px;
      overflow-y: auto;
    }

    .mobile-menu.open {
      display: flex;
    }

    /* The floating WhatsApp bubble (bottom-left, z-index above everything)
       used to sit right on top of the menu's pinned My Account button —
       hide it while the menu is open so the login entry is actually
       visible and tappable. */
    .mobile-menu.open~.wa-fab {
      opacity: 0;
      pointer-events: none;
    }

    .mobile-menu a {
      padding: 14px 18px;
      border-radius: 12px;
      font-size: 16px;
      font-weight: 500;
      color: var(--text);
      display: flex;
      align-items: center;
      gap: 12px;
      transition: background .15s, transform .15s;
    }

    .mobile-menu a:hover {
      background: var(--mist);
      color: var(--leaf);
      transform: translateX(2px);
    }

    .mobile-menu a i {
      width: 22px;
      text-align: center;
      color: var(--leaf);
    }

    /* My Account — pinned to the bottom and styled as the menu's primary
       action instead of one more plain list row. */
    .mobile-menu a:last-child {
      margin-top: auto;
      justify-content: center;
      background: linear-gradient(135deg, var(--leaf) 0%, var(--forest) 100%);
      color: #fff;
      font-weight: 700;
      border-radius: 999px;
      padding: 15px 18px;
      box-shadow: 0 8px 24px rgba(46, 107, 65, .28);
    }

    .mobile-menu a:last-child i {
      color: #fff;
    }

    .mobile-menu a:last-child:hover {
      transform: none;
      background: linear-gradient(135deg, var(--leaf) 0%, var(--forest) 100%);
      color: #fff;
    }

    .nav-login-btn.logged-in {
      background: rgba(46, 107, 65, .08);
      border-color: rgba(46, 107, 65, .3);
    }

    .catalogue-toolbar {
      margin-bottom: 28px;
    }

    .catalogue-search-row {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
      margin-bottom: 14px;
    }

    .catalogue-search-wrap {
      flex: 1;
      min-width: 220px;
      position: relative;
    }

    .catalogue-search-wrap input {
      width: 100%;
      padding: 12px 42px 12px 42px;
      border: 1.5px solid var(--border);
      border-radius: 50px;
      font-size: 14px;
      background: var(--white);
    }

    .catalogue-search-wrap .search-icon {
      position: absolute;
      left: 16px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text3);
    }

    .catalogue-search-wrap .search-clear {
      position: absolute;
      right: 14px;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      color: var(--text3);
      font-size: 14px;
      display: none;
    }

    .catalogue-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 12px;
    }

    .catalogue-chip {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 16px;
      border-radius: 999px;
      background: rgba(46, 107, 65, .1);
      border: 1px solid rgba(46, 107, 65, .18);
      color: var(--forest);
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      transition: all .25s;
      min-height: 42px;
    }

    .catalogue-chip i {
      display: grid;
      place-items: center;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: rgba(46, 107, 65, .2);
      color: var(--leaf);
      font-size: 12px;
    }

    .catalogue-chip span {
      display: inline-block;
      line-height: 1.1;
    }

    .catalogue-chip:hover,
    .catalogue-chip.active {
      background: var(--leaf);
      border-color: var(--leaf);
      color: #fff;
    }

    .catalogue-chip:hover i,
    .catalogue-chip.active i {
      background: rgba(255, 255, 255, .24);
      color: #fff;
    }

    .filter-count {
      min-width: 18px;
      height: 18px;
      border-radius: 999px;
      background: var(--leaf);
      color: #fff;
      font-size: 10px;
      font-weight: 800;
      display: none;
      align-items: center;
      justify-content: center;
    }

    .filter-count.show {
      display: inline-flex;
    }

    .cat-chip {
      padding: 6px 14px;
      height: 30px;
      border-radius: 50px;
      font-size: 12px;
      font-weight: 600;
      border: 1.5px solid var(--border);
      background: var(--white);
      color: var(--text2);
      cursor: pointer;
      transition: all .2s;
    }

    .cat-chip.active,
    .cat-chip:hover {
      background: var(--leaf);
      color: #fff;
      border-color: var(--leaf);
    }

    .cat-chip.rating-chip {
      font-size: 11px;
    }

    .product-card.paused-card {
      opacity: .65;
      filter: grayscale(.25);
    }

    .product-card.paused-card .paused-label {
      position: absolute;
      top: 12px;
      right: 12px;
      background: rgba(0, 0, 0, .65);
      color: #fff;
      font-size: 10px;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 20px;
      text-transform: uppercase;
    }

    .shop-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 10px;
      font-weight: 700;
      color: var(--gold);
      background: rgba(199, 153, 58, .12);
      padding: 3px 8px;
      border-radius: 20px;
      margin: 4px 0;
    }

    .rating-stars {
      font-size: 12px;
      color: var(--gold);
      letter-spacing: 1px;
    }

    .rating-count {
      font-size: 11px;
      color: var(--text3);
      margin-left: 4px;
    }

    .modal-reviews {
      margin-top: 20px;
      border-top: 1px solid var(--border);
      padding-top: 16px;
    }

    .review-item {
      padding: 10px 0;
      border-bottom: 1px solid var(--border);
      font-size: 13px;
    }

    .review-form {
      margin-top: 12px;
      padding: 14px;
      background: var(--mist);
      border-radius: 12px;
    }

    .star-picker {
      display: flex;
      gap: 6px;
      margin: 8px 0;
    }

    .star-picker button {
      background: none;
      font-size: 22px;
      color: var(--border);
      padding: 0;
    }

    .star-picker button.on {
      color: var(--gold);
    }

    .modal-wa-contact {
      margin: 16px 0;
      padding: 12px;
      background: rgba(37, 211, 102, .08);
      border-radius: 12px;
      font-size: 13px;
    }

    .mobile-menu {
      display: none;
      position: fixed;
      top: 66px;
      left: 0;
      right: 0;
      bottom: 0;
      background: var(--cream);
      z-index: 999;
      padding: 24px;
      flex-direction: column;
      gap: 6px;
    }

    .mobile-menu.open {
      display: flex;
    }

    .mobile-menu a {
      padding: 14px 18px;
      border-radius: 12px;
      font-size: 16px;
      font-weight: 500;
      color: var(--text);
      display: flex;
      align-items: center;
      gap: 12px;
      transition: background .15s;
    }

    .mobile-menu a:hover {
      background: var(--mist);
      color: var(--leaf);
    }

    .mobile-menu a i {
      width: 22px;
      text-align: center;
      color: var(--leaf);
    }

    /* ─── HERO ───────────────────────────────────── */
    .hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: center;
      background:
        radial-gradient(ellipse 90% 70% at 75% 30%, rgba(46, 107, 65, .35) 0%, transparent 60%),
        linear-gradient(150deg, var(--forest) 0%, var(--forest2) 55%, #081410 100%);
      overflow: hidden;
      padding-top: 76px;
    }

    .hero-bg-pattern {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 50% 50% at 85% 65%, rgba(132, 206, 116, .10) 0%, transparent 70%),
        radial-gradient(ellipse 40% 50% at 8% 85%, rgba(199, 153, 58, .10) 0%, transparent 60%);
      pointer-events: none;
    }

    .hero-grain {
      position: absolute;
      inset: 0;
      opacity: .03;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
      pointer-events: none;
    }

    .hero-watermark {
      position: absolute;
      bottom: -8%;
      left: -6%;
      width: clamp(280px, 38vw, 560px);
      opacity: .045;
      transform: rotate(-8deg);
      pointer-events: none;
      user-select: none;
      z-index: 0;
    }

    .hero-inner {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: clamp(40px, 5vw, 72px);
      align-items: center;
      width: 100%;
      padding: clamp(56px, 7vw, 96px) 0;
    }

    .hero-content .eyebrow {
      background: rgba(132, 206, 116, .12);
      border-color: rgba(132, 206, 116, .28);
      color: var(--lime);
    }

    .hero-title {
      font-family: var(--font-display);
      font-size: clamp(38px, 5.4vw, 62px);
      font-weight: 600;
      color: var(--white);
      line-height: 1.06;
      letter-spacing: -.02em;
      margin-bottom: 22px;
    }

    .hero-title .accent {
      font-style: normal;
      color: var(--lime);
    }

    .hero-subtitle {
      font-size: 17px;
      color: rgba(255, 255, 255, .66);
      line-height: 1.75;
      max-width: 460px;
      margin-bottom: 38px;
    }

    .hero-actions {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
      margin-bottom: 44px;
    }

    .hero-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
      max-width: 480px;
    }

    .hero-stat {
      padding: 18px 14px;
      background: rgba(255, 255, 255, .05);
      border: 1px solid rgba(255, 255, 255, .09);
      border-radius: var(--r);
      text-align: center;
      transition: transform .25s, border-color .25s, background .25s;
    }

    .hero-stat:hover {
      transform: translateY(-3px);
      border-color: rgba(132, 206, 116, .3);
      background: rgba(255, 255, 255, .08);
    }

    .hero-stat-num {
      font-family: var(--font-display);
      font-size: 28px;
      font-weight: 700;
      color: var(--lime);
      line-height: 1;
    }

    .hero-stat-label {
      font-size: 11px;
      color: rgba(255, 255, 255, .5);
      margin-top: 6px;
      font-weight: 500;
      letter-spacing: .05em;
      text-transform: uppercase;
    }

    /* Hero visual — premium image showcase */
    .hero-visual {
      position: relative;
    }

    .hero-image-frame {
      position: relative;
      border-radius: var(--r-xl);
      overflow: hidden;
      box-shadow: var(--sh-lg);
      border: 1px solid rgba(255, 255, 255, .12);
      aspect-ratio: 1 / 1;
    }

    .hero-image-frame img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transform: scale(1.02);
      transition: transform 1.2s cubic-bezier(.22, 1, .36, 1);
    }

    .hero-visual:hover .hero-image-frame img {
      transform: scale(1.08);
    }

    .hero-image-frame::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, transparent 45%, rgba(8, 20, 16, .55) 100%);
      pointer-events: none;
    }

    .hero-float-card {
      position: absolute;
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 13px 18px;
      background: rgba(20, 38, 30, .72);
      border: 1px solid rgba(255, 255, 255, .16);
      border-radius: 16px;
      backdrop-filter: blur(14px);
      box-shadow: var(--sh-md);
      z-index: 2;
    }

    .hero-float-card .hfc-icon {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      display: grid;
      place-items: center;
      background: var(--gradient-leaf);
      color: #fff;
      font-size: 16px;
      flex-shrink: 0;
    }

    .hero-float-card .hfc-num {
      font-family: var(--font-display);
      font-weight: 700;
      color: #fff;
      font-size: 17px;
      line-height: 1;
    }

    .hero-float-card .hfc-label {
      font-size: 11px;
      color: rgba(255, 255, 255, .6);
      margin-top: 3px;
      letter-spacing: .03em;
    }

    .hero-float-card.top {
      top: 24px;
      left: -18px;
    }

    .hero-float-card.bottom {
      bottom: 24px;
      right: -18px;
    }

    .hero-float-card.top .hfc-icon {
      background: var(--gradient-gold);
    }

    .float-anim-1 {
      animation: floaty 6s ease-in-out infinite;
    }

    .float-anim-2 {
      animation: floaty 6s ease-in-out infinite 3s;
    }

    @keyframes floaty {

      0%,
      100% {
        transform: translateY(0);
      }

      50% {
        transform: translateY(-10px);
      }
    }

    .hero-trust-bar {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 22px;
    }

    .trust-chip {
      display: flex;
      align-items: center;
      gap: 7px;
      padding: 8px 15px;
      background: rgba(255, 255, 255, .06);
      border: 1px solid rgba(255, 255, 255, .12);
      border-radius: 40px;
      font-size: 12.5px;
      color: rgba(255, 255, 255, .72);
      font-weight: 500;
      transition: border-color .2s, background .2s;
    }

    .trust-chip:hover {
      border-color: rgba(132, 206, 116, .4);
      background: rgba(255, 255, 255, .1);
    }

    .trust-chip i {
      color: var(--lime);
      font-size: 12px;
    }

    /* ─── MARQUEE ────────────────────────────────── */
    .marquee-section {
      background: var(--forest);
      padding: 14px 0;
      overflow: hidden;
      border-top: 1px solid rgba(255, 255, 255, .06);
      border-bottom: 1px solid rgba(255, 255, 255, .06);
    }

    .marquee-track {
      display: flex;
      gap: 0;
      white-space: nowrap;
      animation: marquee 28s linear infinite;
    }

    .marquee-item {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 0 28px;
      font-size: 13px;
      font-weight: 600;
      color: rgba(255, 255, 255, .55);
      letter-spacing: .04em;
      text-transform: uppercase;
      flex-shrink: 0;
    }

    .marquee-item i {
      color: var(--lime);
      font-size: 10px;
    }

    @keyframes marquee {
      from {
        transform: translateX(0);
      }

      to {
        transform: translateX(-50%);
      }
    }

    /* ─── PRODUCTS ───────────────────────────────── */
    .products-section {
      padding: 100px 0;
      background: var(--cream);
    }

    .products-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 48px;
      gap: 20px;
      flex-wrap: wrap;
    }

    .catalogue-loading {
      text-align: center;
      padding: 80px 0;
      color: var(--text3);
    }

    .catalogue-loading i {
      font-size: 36px;
      color: var(--leaf);
      margin-bottom: 12px;
    }

    .catalogue-loading p {
      font-size: 14px;
    }

    .products-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 24px;
    }

    .product-card {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--r-lg);
      overflow: hidden;
      transition: all .25s;
      display: flex;
      flex-direction: column;
      box-shadow: var(--sh);
    }

    .product-card:hover {
      box-shadow: var(--sh-md);
      transform: translateY(-4px);
      border-color: rgba(46, 107, 65, .2);
    }

    .product-card-img {
      width: 100%;
      height: 200px;
      object-fit: cover;
      background:
        radial-gradient(circle at 30% 25%, rgba(132, 206, 116, .18), transparent 60%),
        linear-gradient(135deg, var(--mist), #dde8de);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--leaf);
      position: relative;
      overflow: hidden;
    }

    .product-card-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      position: absolute;
      inset: 0;
    }

    .product-card-img .img-fallback {
      position: relative;
      z-index: 1;
      width: 86px;
      height: 86px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: rgba(255, 255, 255, .55);
      border: 1px solid rgba(46, 107, 65, .14);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, .6);
    }

    .product-card-img .img-fallback i {
      font-size: 38px;
      color: var(--leaf);
    }

    .product-card:hover .img-fallback {
      transform: scale(1.06);
      transition: transform .35s cubic-bezier(.22, 1, .36, 1);
    }

    .product-card-body {
      padding: 22px;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .product-card-category {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--leaf);
      margin-bottom: 6px;
    }

    .product-card-name {
      font-family: var(--font-display);
      font-size: 18px;
      font-weight: 700;
      color: var(--earth);
      margin-bottom: 8px;
      line-height: 1.25;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    /* Heart/wishlist button overlaid on the card image — same pattern as
       portal.html's .product-card-like-btn, ported here for parity. */
    .product-card-like-btn {
      position: absolute;
      top: 9px;
      right: 9px;
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: rgba(255, 255, 255, .92);
      backdrop-filter: blur(6px);
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      color: #9AA39C;
      box-shadow: 0 3px 10px rgba(20, 48, 38, .14);
      transition: all .15s ease;
      z-index: 2;
    }

    .product-card-like-btn:hover {
      transform: scale(1.1);
    }

    .product-card-like-btn.liked {
      color: #E1435A;
    }

    .product-card-like-btn.liked i {
      font-weight: 900;
    }

    /* Small stock-status pill under the price, mirroring portal.html */
    .product-card-stock-pill {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 9.5px;
      font-weight: 700;
      color: var(--color-feedback-success);
      margin-top: 6px;
    }

    .product-card-stock-pill i {
      font-size: 6px;
    }

    .product-card-desc {
      font-size: 13px;
      color: var(--text3);
      line-height: 1.55;
      margin-bottom: 12px;
    }

    .product-card-meta {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 18px;
    }

    .product-card-meta .tag {
      background: var(--mist);
      color: var(--leaf);
      border: 1px solid rgba(46, 107, 65, .15);
    }

    .product-card-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .product-price {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 18px;
      color: var(--earth);
    }

    .product-price small {
      font-size: 12px;
      font-weight: 500;
      color: var(--text3);
    }

    .product-order-btn {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 9px 18px;
      background: var(--leaf);
      color: #fff;
      font-size: 13px;
      font-weight: 600;
      border-radius: 40px;
      transition: all .2s;
    }

    .product-order-btn:hover {
      background: var(--forest);
      transform: translateY(-1px);
    }

    .products-empty {
      grid-column: 1 / -1;
      text-align: center;
      padding: 80px 20px;
      color: var(--text3);
    }

    .products-empty i {
      font-size: 48px;
      margin-bottom: 16px;
      color: var(--border);
    }

    .products-empty h3 {
      font-family: var(--font-display);
      font-size: 20px;
      color: var(--text2);
      margin-bottom: 8px;
    }

    /* Default product data */
    .default-products {
      display: contents;
    }

    /* ─── WHY US ─────────────────────────────────── */
    .why-section {
      padding: 100px 0;
      background: var(--forest);
      position: relative;
      overflow: hidden;
    }

    .why-section::before {
      content: '';
      position: absolute;
      top: -100px;
      right: -100px;
      width: 500px;
      height: 500px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(109, 191, 103, .08) 0%, transparent 70%);
      pointer-events: none;
    }

    .why-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: center;
    }

    .why-content .eyebrow {
      background: rgba(109, 191, 103, .1);
      border-color: rgba(109, 191, 103, .2);
      color: var(--lime);
    }

    .why-content .section-title {
      color: var(--white);
      margin-bottom: 14px;
    }

    .why-content p {
      color: rgba(255, 255, 255, .6);
      font-size: 16px;
      line-height: 1.75;
      margin-bottom: 32px;
    }

    .why-features {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .why-feature {
      display: flex;
      align-items: flex-start;
      gap: 16px;
      padding: 18px;
      background: rgba(255, 255, 255, .04);
      border: 1px solid rgba(255, 255, 255, .07);
      border-radius: var(--r);
    }

    .why-feature-icon {
      width: 44px;
      height: 44px;
      background: rgba(109, 191, 103, .12);
      border-radius: 11px;
      display: grid;
      place-items: center;
      flex-shrink: 0;
    }

    .why-feature-icon i {
      color: var(--lime);
      font-size: 18px;
    }

    .why-feature-title {
      font-weight: 600;
      color: var(--white);
      font-size: 15px;
      margin-bottom: 4px;
    }

    .why-feature-text {
      font-size: 13px;
      color: rgba(255, 255, 255, .5);
      line-height: 1.6;
    }

    .why-creds {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .cred-card {
      background: rgba(255, 255, 255, .05);
      border: 1px solid rgba(255, 255, 255, .09);
      border-radius: var(--r);
      padding: 24px 20px;
      text-align: center;
    }

    .cred-card i {
      font-size: 28px;
      color: var(--lime);
      margin-bottom: 12px;
      display: block;
    }

    .cred-card-label {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, .4);
      margin-bottom: 4px;
    }

    .cred-card-value {
      font-family: var(--font-display);
      font-size: 15px;
      font-weight: 700;
      color: var(--white);
      word-break: break-all;
    }

    /* ─── SELL SECTION ───────────────────────────── */
    .sell-section {
      padding: 100px 0;
      background: var(--sand);
    }

    .sell-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: start;
    }

    .sell-info .eyebrow {
      background: rgba(201, 149, 42, .1);
      border-color: rgba(201, 149, 42, .25);
      color: var(--gold);
    }

    .sell-info .section-title {
      margin-bottom: 14px;
    }

    .sell-info p {
      color: var(--text2);
      font-size: 16px;
      line-height: 1.75;
      margin-bottom: 28px;
    }

    .sell-steps {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .sell-step {
      display: flex;
      align-items: flex-start;
      gap: 16px;
    }

    .sell-step-num {
      width: 36px;
      height: 36px;
      background: var(--gold);
      color: #fff;
      border-radius: 50%;
      display: grid;
      place-items: center;
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 16px;
      flex-shrink: 0;
    }

    .sell-step-text h4 {
      font-weight: 600;
      color: var(--earth);
      margin-bottom: 2px;
      font-size: 15px;
    }

    .sell-step-text p {
      font-size: 13px;
      color: var(--text3);
    }

    .sell-form-box {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--r-lg);
      padding: 36px;
      box-shadow: var(--sh);
    }

    .sell-form-box h3 {
      font-family: var(--font-display);
      font-size: 22px;
      font-weight: 800;
      color: var(--earth);
      margin-bottom: 6px;
    }

    .sell-form-box p {
      font-size: 13px;
      color: var(--text3);
      margin-bottom: 28px;
    }

    /* ─── FORMS ──────────────────────────────────── */
    .form-group {
      margin-bottom: 18px;
    }

    .form-label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: var(--text2);
      margin-bottom: 7px;
    }

    .form-label .req {
      color: var(--color-feedback-error);
    }

    .form-input,
    .form-select,
    .form-textarea {
      width: 100%;
      padding: 12px 16px;
      border: 1.5px solid var(--border);
      border-radius: 10px;
      font-size: 14px;
      color: var(--text);
      background: var(--white);
      outline: none;
      transition: all .2s;
    }

    .form-input:focus,
    .form-select:focus,
    .form-textarea:focus {
      border-color: var(--leaf);
      box-shadow: 0 0 0 3px rgba(46, 107, 65, .1);
    }

    .form-textarea {
      resize: vertical;
      min-height: 90px;
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    .form-submit {
      width: 100%;
      padding: 14px;
      background: linear-gradient(135deg, var(--leaf), #3D8C50);
      color: #fff;
      font-size: 15px;
      font-weight: 600;
      border-radius: 12px;
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all .2s;
      box-shadow: 0 4px 16px rgba(46, 107, 65, .25);
    }

    .form-submit:hover {
      background: var(--forest);
      box-shadow: 0 6px 24px rgba(46, 107, 65, .35);
    }

    .form-submit:disabled {
      opacity: .6;
      cursor: not-allowed;
    }

    .form-success {
      display: none;
      text-align: center;
      padding: 36px 20px;
    }

    .form-success.show {
      display: block;
    }

    .form-success i {
      font-size: 48px;
      color: var(--leaf);
      margin-bottom: 16px;
    }

    .form-success h3 {
      font-family: var(--font-display);
      font-size: 22px;
      font-weight: 800;
      color: var(--earth);
      margin-bottom: 8px;
    }

    .form-success p {
      font-size: 14px;
      color: var(--text3);
    }

    .form-err {
      font-size: 12px;
      color: var(--color-feedback-error);
      margin-top: 5px;
      display: none;
    }

    .form-err.show {
      display: block;
    }

    .api-error-msg {
      background: #FEF2F2;
      border: 1px solid #FECACA;
      border-radius: 10px;
      padding: 12px 16px;
      font-size: 13px;
      color: #DC2626;
      margin-top: 12px;
      display: none;
    }

    .api-error-msg.show {
      display: block;
    }

    /* ─── ORDER SECTION ──────────────────────────── */
    .order-section {
      padding: 100px 0;
      background: var(--cream);
    }

    .order-grid {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 40px;
      align-items: start;
    }

    .order-form-box {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--r-lg);
      padding: 40px;
      box-shadow: var(--sh);
    }

    .order-form-box h3 {
      font-family: var(--font-display);
      font-size: 24px;
      font-weight: 800;
      color: var(--earth);
      margin-bottom: 6px;
    }

    .order-form-box>p {
      font-size: 14px;
      color: var(--text3);
      margin-bottom: 32px;
    }

    .order-sidebar {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .sidebar-card {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--r-lg);
      padding: 28px;
      box-shadow: var(--sh);
    }

    .sidebar-card h4 {
      font-family: var(--font-display);
      font-size: 17px;
      font-weight: 700;
      color: var(--earth);
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .sidebar-card h4 i {
      color: var(--leaf);
    }

    .sidebar-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .sidebar-list li {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 13px;
      color: var(--text2);
    }

    .sidebar-list li i {
      color: var(--leaf);
      width: 16px;
      text-align: center;
      flex-shrink: 0;
    }

    .order-type-tabs {
      display: flex;
      gap: 10px;
      margin-bottom: 28px;
    }

    .order-type-tab {
      flex: 1;
      padding: 12px;
      border: 2px solid var(--border);
      border-radius: 12px;
      background: transparent;
      color: var(--text2);
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: all .2s;
      text-align: center;
    }

    .order-type-tab.active {
      border-color: var(--leaf);
      background: rgba(46, 107, 65, .06);
      color: var(--leaf);
    }

    .form-section-title {
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .1em;
      color: var(--text3);
      border-bottom: 1px solid var(--border);
      padding-bottom: 8px;
      margin: 24px 0 18px;
    }

    /* ─── TRACK ORDER ────────────────────────────── */
    .track-section {
      padding: 70px 0;
      background: var(--mist);
    }

    .track-inner {
      max-width: 600px;
      margin: 0 auto;
      text-align: center;
    }

    .track-inner .section-title {
      margin-bottom: 10px;
    }

    .track-inner p {
      color: var(--text3);
      font-size: 15px;
      margin-bottom: 28px;
    }

    .track-form {
      display: flex;
      gap: 12px;
    }

    .track-input {
      flex: 1;
      padding: 14px 20px;
      border: 1.5px solid var(--border);
      border-radius: 50px;
      font-size: 15px;
      color: var(--text);
      background: var(--white);
      outline: none;
      transition: border-color .2s;
      letter-spacing: .04em;
      text-transform: uppercase;
    }

    .track-input:focus {
      border-color: var(--leaf);
      box-shadow: 0 0 0 3px rgba(46, 107, 65, .1);
    }

    .track-input::placeholder {
      text-transform: none;
      letter-spacing: 0;
    }

    .track-btn {
      padding: 14px 28px;
      background: var(--leaf);
      color: #fff;
      font-size: 14px;
      font-weight: 600;
      border-radius: 50px;
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: all .2s;
      white-space: nowrap;
    }

    .track-btn:hover {
      background: var(--forest);
    }

    .track-result {
      margin-top: 28px;
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--r-lg);
      padding: 28px;
      text-align: left;
      display: none;
    }

    .track-result.show {
      display: block;
    }

    .track-result-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 20px;
      gap: 12px;
    }

    .track-result h4 {
      font-family: var(--font-display);
      font-size: 18px;
      font-weight: 700;
      color: var(--earth);
    }

    .track-result p {
      font-size: 13px;
      color: var(--text3);
      margin-top: 2px;
    }

    .status-badge {
      padding: 5px 14px;
      border-radius: 30px;
      font-size: 12px;
      font-weight: 600;
      white-space: nowrap;
    }

    .status-badge.pending {
      background: #FEF3C7;
      color: #D97706;
    }

    .status-badge.completed {
      background: #D1FAE5;
      color: #059669;
    }

    .status-badge.processing {
      background: #DBEAFE;
      color: #2563EB;
    }

    .status-timeline {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-top: 16px;
    }

    .timeline-item {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .timeline-dot {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      flex-shrink: 0;
    }

    .timeline-dot.done {
      background: var(--leaf);
    }

    .timeline-dot.done i {
      color: #fff;
      font-size: 12px;
    }

    .timeline-dot.pending-dot {
      background: var(--border);
    }

    .timeline-dot.pending-dot i {
      color: var(--text3);
      font-size: 12px;
    }

    .timeline-text h5 {
      font-size: 14px;
      font-weight: 600;
      color: var(--text);
    }

    .timeline-text span {
      font-size: 12px;
      color: var(--text3);
    }

    .track-error {
      margin-top: 16px;
      padding: 14px 18px;
      background: #FEF2F2;
      border: 1px solid #FECACA;
      border-radius: 10px;
      font-size: 14px;
      color: #DC2626;
      text-align: center;
      display: none;
    }

    .track-error.show {
      display: block;
    }

    /* ─── ABOUT ──────────────────────────────────── */
    .about-section {
      padding: 100px 0;
      background: var(--cream);
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 64px;
      align-items: start;
    }

    .about-content .eyebrow {
      background: rgba(46, 107, 65, .07);
      border-color: rgba(46, 107, 65, .15);
      color: var(--leaf);
    }

    .about-content .section-title {
      margin-bottom: 14px;
    }

    .about-content p {
      color: var(--text2);
      font-size: 16px;
      line-height: 1.8;
      margin-bottom: 20px;
    }

    .about-creds-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-top: 8px;
    }

    .about-cred {
      padding: 18px;
      background: var(--mist);
      border: 1px solid rgba(46, 107, 65, .12);
      border-radius: var(--r);
    }

    .about-cred-label {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--leaf);
      margin-bottom: 4px;
    }

    .about-cred-value {
      font-family: var(--font-display);
      font-size: 13px;
      font-weight: 700;
      color: var(--earth);
      word-break: break-all;
    }

    .social-links-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .social-link-card {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 16px;
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--r);
      transition: all .2s;
      text-decoration: none;
    }

    .social-link-card:hover {
      border-color: var(--leaf);
      transform: translateX(3px);
    }

    .social-link-icon {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      display: grid;
      place-items: center;
      flex-shrink: 0;
      font-size: 18px;
    }

    .social-link-text {
      font-size: 13px;
      font-weight: 600;
      color: var(--text);
    }

    .social-link-sub {
      font-size: 11px;
      color: var(--text3);
    }

    .about-contact-card {
      background: var(--forest);
      border-radius: var(--r-lg);
      padding: 32px;
      color: #fff;
      margin-top: 24px;
    }

    .about-contact-card h4 {
      font-family: var(--font-display);
      font-size: 20px;
      font-weight: 800;
      margin-bottom: 20px;
    }

    .contact-row {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 14px;
    }

    .contact-row i {
      color: var(--lime);
      width: 20px;
      text-align: center;
    }

    .contact-row a {
      color: rgba(255, 255, 255, .8);
      font-size: 14px;
      transition: color .15s;
    }

    .contact-row a:hover {
      color: var(--lime);
    }

    /* ─── MODAL ──────────────────────────────────── */
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, .55);
      z-index: 2000;
      align-items: center;
      justify-content: center;
      padding: 20px;
      backdrop-filter: blur(4px);
    }

    .modal-overlay.open {
      display: flex;
    }

    .modal {
      background: var(--white);
      border-radius: var(--r-lg);
      width: 100%;
      max-width: 560px;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: 0 24px 80px rgba(0, 0, 0, .3);
    }

    .modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 24px 28px 0;
      margin-bottom: 20px;
    }

    .modal-header h3 {
      font-family: var(--font-display);
      font-size: 20px;
      font-weight: 800;
      color: var(--earth);
    }

    .modal-close {
      width: 36px;
      height: 36px;
      background: var(--mist);
      border-radius: 50%;
      display: grid;
      place-items: center;
      cursor: pointer;
      color: var(--text2);
      font-size: 16px;
      transition: all .15s;
      flex-shrink: 0;
    }

    .modal-close:hover {
      background: var(--border);
      color: var(--earth);
    }

    .modal-body {
      padding: 0 28px 28px;
    }

    .modal-product-info {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
      padding: 16px;
      background: var(--mist);
      border-radius: var(--r);
      margin-bottom: 24px;
    }

    .modal-product-icon {
      width: 100%;
      min-height: 160px;
      max-height: 220px;
      background: var(--white);
      border-radius: 14px;
      display: grid;
      place-items: center;
      font-size: 48px;
      flex-shrink: 0;
      overflow: hidden;
    }

    .modal-product-icon i {
      color: var(--leaf);
    }

    .modal-product-icon img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 12px;
    }

    .modal-product-name {
      font-family: var(--font-display);
      font-weight: 700;
      color: var(--earth);
      font-size: 16px;
    }

    .modal-product-meta {
      font-size: 12px;
      color: var(--text3);
      margin-top: 2px;
    }

    /* ─── TOAST ──────────────────────────────────── */
    /* Legacy .toast-container/.toast (hardcoded-hex, bottom-right) removed
       here — index.html now uses the single shared #toast host from
       components.css / CatalogueUI.toast() (see JS toast() wrapper below
       and the #toast div near the footer). See Phase 3 notes. */

    /* ─── FOOTER ─────────────────────────────────── */
    .footer {
      background: var(--earth);
      padding: 64px 0 32px;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 40px;
      margin-bottom: 48px;
    }

    .footer-brand-lockup {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 14px;
    }

    .footer-brand-logo {
      width: 38px;
      height: auto;
      flex-shrink: 0;
      filter: drop-shadow(0 2px 6px rgba(0, 0, 0, .25));
    }

    .footer-brand-name {
      font-family: var(--font-display);
      font-size: 22px;
      font-weight: 800;
      color: var(--white);
    }

    .footer-brand-desc {
      font-size: 13px;
      color: rgba(255, 255, 255, .45);
      line-height: 1.7;
      margin-bottom: 20px;
    }

    .footer-social {
      display: flex;
      gap: 10px;
    }

    .footer-social a {
      width: 36px;
      height: 36px;
      background: rgba(255, 255, 255, .07);
      border-radius: 9px;
      display: grid;
      place-items: center;
      color: rgba(255, 255, 255, .55);
      font-size: 14px;
      transition: all .2s;
    }

    .footer-social a:hover {
      background: var(--leaf);
      color: #fff;
    }

    .footer-col-title {
      font-family: var(--font-display);
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .07em;
      color: rgba(255, 255, 255, .4);
      margin-bottom: 18px;
    }

    .footer-col-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .footer-col-list li a {
      font-size: 13px;
      color: rgba(255, 255, 255, .55);
      transition: color .15s;
      display: flex;
      align-items: center;
      gap: 7px;
    }

    .footer-col-list li a:hover {
      color: var(--lime);
    }

    .footer-col-list li a i {
      font-size: 11px;
    }

    .footer-divider {
      height: 1px;
      background: rgba(255, 255, 255, .07);
      margin-bottom: 28px;
    }

    .footer-bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      flex-wrap: wrap;
    }

    .footer-bottom p {
      font-size: 12px;
      color: rgba(255, 255, 255, .3);
    }

    .footer-certs {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .footer-cert {
      padding: 5px 12px;
      background: rgba(255, 255, 255, .05);
      border: 1px solid rgba(255, 255, 255, .08);
      border-radius: 20px;
      font-size: 11px;
      color: rgba(255, 255, 255, .4);
      font-weight: 500;
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .footer-cert i {
      color: var(--lime);
    }

    /* ─── STICKY WA BUTTON ───────────────────────── */
    .wa-fab {
      position: fixed;
      bottom: 28px;
      left: 28px;
      z-index: 1500;
      width: 58px;
      height: 58px;
      background: #25D366;
      border-radius: 50%;
      display: grid;
      place-items: center;
      box-shadow: 0 6px 24px rgba(37, 211, 102, .4);
      transition: all .25s;
    }

    .wa-fab:hover {
      transform: scale(1.08);
      box-shadow: 0 10px 32px rgba(37, 211, 102, .5);
    }

    .wa-fab i {
      color: #fff;
      font-size: 26px;
    }

    .wa-fab-tooltip {
      position: absolute;
      left: 68px;
      background: var(--earth);
      color: #fff;
      font-size: 12px;
      font-weight: 600;
      padding: 6px 12px;
      border-radius: 6px;
      white-space: nowrap;
      opacity: 0;
      pointer-events: none;
      transition: opacity .2s;
    }

    .wa-fab:hover .wa-fab-tooltip {
      opacity: 1;
    }

    /* ─── RESPONSIVE ─────────────────────────────── */
    @media (max-width: 900px) {
      .hero-inner {
        grid-template-columns: 1fr;
        gap: 44px;
        padding: 60px 0;
      }

      .hero-visual {
        order: -1;
        max-width: none;
        width: calc(100% + (2 * var(--container-pad)));
        margin-left: calc(-1 * var(--container-pad));
        margin-right: calc(-1 * var(--container-pad));
      }

      .hero-image-frame {
        border-radius: 0;
        border-left: none;
        border-right: none;
      }

      .hero-content {
        text-align: center;
      }

      .hero-content .eyebrow {
        margin-left: auto;
        margin-right: auto;
      }

      .hero-subtitle {
        margin-left: auto;
        margin-right: auto;
      }

      .hero-actions {
        justify-content: center;
      }

      .hero-stats {
        margin-left: auto;
        margin-right: auto;
      }

      .hero-trust-bar {
        justify-content: center;
      }

      .why-grid {
        grid-template-columns: 1fr;
        gap: 40px;
      }

      .sell-grid {
        grid-template-columns: 1fr;
        gap: 40px;
      }

      .order-grid {
        grid-template-columns: 1fr;
      }

      .about-grid {
        grid-template-columns: 1fr;
        gap: 40px;
      }

      .footer-grid {
        grid-template-columns: 1fr 1fr;
      }

      .nav-inner {
        height: 56px;
      }

      .nav-logo-sub {
        display: none;
      }

      .nav-cta {
        gap: 8px;
      }

      .nav-social {
        display: none;
      }

      .nav-cta .btn-primary {
        display: none;
      }

      .nav-cta .nav-whatsapp {
        display: none;
      }

      .nav-cta .nav-login-btn {
        display: inline-flex;
      }

      .nav-toggle {
        display: flex;
      }
    }

    @media (max-width: 600px) {
      :root {
        --container-pad: 16px;
      }

      .container {
        padding: 0 var(--container-pad);
      }

      .products-section,
      .why-section,
      .sell-section,
      .about-section {
        padding: 70px 0;
      }

      .hero-stats {
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        max-width: 100%;
      }

      .hero-stat-num {
        font-size: 22px;
      }

      .hero-stat {
        padding: 14px 8px;
      }

      .hero-float-card {
        padding: 10px 13px;
      }

      .hero-float-card .hfc-num {
        font-size: 14px;
      }

      .hero-float-card .hfc-label {
        font-size: 10px;
      }

      .hero-float-card.top {
        left: -6px;
      }

      .hero-float-card.bottom {
        right: -6px;
      }

      .form-row {
        grid-template-columns: 1fr;
      }

      .why-creds {
        grid-template-columns: 1fr;
      }

      .about-creds-grid {
        grid-template-columns: 1fr;
      }

      .social-links-grid {
        grid-template-columns: 1fr;
      }

      .footer-grid {
        grid-template-columns: 1fr;
      }

      .track-form {
        flex-direction: column;
      }

      .modal {
        max-height: 95vh;
      }

      .wa-fab {
        bottom: 16px;
        left: 16px;
      }
    }

    @media (prefers-reduced-motion: reduce) {

      *,
      *::before,
      *::after {
        animation-duration: .001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .001ms !important;
        scroll-behavior: auto !important;
      }
    }

    /* ─── SCROLL REVEAL ──────────────────────────── */
    .reveal {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity .7s cubic-bezier(.22, 1, .36, 1), transform .7s cubic-bezier(.22, 1, .36, 1);
      will-change: opacity, transform;
    }

    .reveal.in {
      opacity: 1;
      transform: none;
    }

    .reveal[data-delay="1"] {
      transition-delay: .08s;
    }

    .reveal[data-delay="2"] {
      transition-delay: .16s;
    }

    .reveal[data-delay="3"] {
      transition-delay: .24s;
    }

    .reveal[data-delay="4"] {
      transition-delay: .32s;
    }

    /* Hero entrance */
    .hero-content>* {
      opacity: 0;
      animation: heroIn .8s cubic-bezier(.22, 1, .36, 1) forwards;
    }

    .hero-content>*:nth-child(1) {
      animation-delay: .05s;
    }

    .hero-content>*:nth-child(2) {
      animation-delay: .15s;
    }

    .hero-content>*:nth-child(3) {
      animation-delay: .25s;
    }

    .hero-content>*:nth-child(4) {
      animation-delay: .35s;
    }

    .hero-content>*:nth-child(5) {
      animation-delay: .45s;
    }

    .hero-content>*:nth-child(6) {
      animation-delay: .55s;
    }

    .hero-visual {
      opacity: 0;
      animation: heroIn 1s cubic-bezier(.22, 1, .36, 1) .35s forwards;
    }

    @keyframes heroIn {
      from {
        opacity: 0;
        transform: translateY(24px);
      }

      to {
        opacity: 1;
        transform: none;
      }
    }

    /* ─── SPINNER ────────────────────────────────── */
    .spinner {
      display: inline-block;
      width: 18px;
      height: 18px;
      border: 2px solid rgba(255, 255, 255, .3);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin .7s linear infinite;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }
  </style>
</head>

<body data-site-mode="index">

  <!-- ── NAV ─────────────────────────────────────── -->
  <nav class="nav" id="mainNav">
    <div class="container">
      <div class="nav-inner">
        <a href="#" class="nav-logo">
          <div class="nav-logo-badge"><img src="assets/logo-mark.png?v=3" alt="Aarvex Global logo"></div>
          <div>
            <div class="nav-logo-name">Aarvex Global</div>
            <div class="nav-logo-sub">Agri Export Specialists</div>
          </div>
        </a>
        <ul class="nav-links">
          <li><a href="#products">Products</a></li>
          <li><a href="#sell">Sell Produce</a></li>
          <li><a href="#about">About Us</a></li>
        </ul>
        <div class="nav-social" aria-label="Social media links">
          <a href="https://www.instagram.com/aarvexglobal" target="_blank" rel="noopener" aria-label="Instagram"><i
              class="fa-brands fa-instagram"></i></a>
          <a href="https://www.facebook.com/profile.php?id=61590539051710" target="_blank" rel="noopener"
            aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
          <a href="https://wa.link/o0a5u0" target="_blank" rel="noopener" aria-label="WhatsApp"><i
              class="fa-brands fa-whatsapp"></i></a>
          <a href="https://www.linkedin.com/in/aarvex-global-994305415/" target="_blank" rel="noopener"
            aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
          <a href="https://x.com/aarvexglobal" target="_blank" rel="noopener" aria-label="X"><i
              class="fa-brands fa-x-twitter"></i></a>
          <a href="https://t.me/aarvexglobal_bot" target="_blank" rel="noopener" aria-label="Telegram"><i
              class="fa-brands fa-telegram"></i></a>
          <a href="https://in.pinterest.com/aarvexglobal/" target="_blank" rel="noopener" aria-label="Pinterest"><i
              class="fa-brands fa-pinterest-p"></i></a>
          <a href="https://www.threads.com/@aarvexglobal" target="_blank" rel="noopener" aria-label="Threads"><i
              class="fa-brands fa-threads"></i></a>
        </div>
        <div class="nav-cta">
          <a href="https://wa.link/o0a5u0" target="_blank" class="nav-whatsapp">
            <i class="fa-brands fa-whatsapp"></i> WhatsApp
          </a>
          <a href="portal.html" class="nav-login-btn" id="navLoginBtn">
            <i class="fa-solid fa-user"></i> Login / My Account
          </a>
        </div>
        <button class="nav-toggle" id="navToggle" aria-label="Menu">
          <i class="fa-solid fa-bars" id="navToggleIcon" style="font-size:20px"></i>
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div class="mobile-menu" id="mobileMenu">
    <a href="#products" onclick="closeMobile()"><i class="fa-solid fa-leaf"></i> Products</a>
    <a href="#sell" onclick="closeMobile()"><i class="fa-solid fa-tractor"></i> Sell Produce</a>
    <a href="#about" onclick="closeMobile()"><i class="fa-solid fa-building"></i> About Us</a>

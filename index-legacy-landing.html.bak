  <!-- ── TOAST HOST (Phase 2) — was missing entirely on this page, so
     product-modal.js's guarded showToast() call was silently a no-op
     here (wishlist errors, save failures, etc. never surfaced). See
     CatalogueUI.toast() in catalogue-ui.js + components.css. ── -->
  <div id="toast"></div>

  <!-- ── PRODUCT DETAIL MODAL ─────────────────────── -->
  <div class="pd-modal-overlay" id="productDetailModal" role="dialog" aria-modal="true" aria-labelledby="pdModalTitle">
    <div class="pd-modal-box">
      <div class="pd-modal-head">
        <h3 id="pdModalTitle">Product Details</h3>
        <button type="button" class="pd-modal-close" onclick="ProductModal.closeModal()" aria-label="Close"><i
            class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="pd-modal-content" id="pdModalBody"></div>
      <div class="pd-modal-actions" id="pdModalActions"></div>
      <div class="pd-reviews-section">
        <h4>Customer Reviews</h4>
        <div id="pdReviewsList"></div>
        <div id="pdShopReactions"></div>
        <div id="pdReviewForm"></div>
      </div>
    </div>
  </div>

  <!-- ── SHOP PROFILE MODAL ────────────────────────── -->
  <div class="pd-modal-overlay" id="shopProfileModal" role="dialog" aria-modal="true"
    aria-labelledby="shopProfileModalTitle">
    <div class="pd-modal-box">
      <div class="pd-modal-head">
        <h3 id="shopProfileModalTitle">Shop Profile</h3>
        <button type="button" class="pd-modal-close" onclick="ProductModal.closeShop()" aria-label="Close"><i
            class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="pd-modal-content" id="shopProfileBody"></div>
    </div>
  </div>

  <!-- ── WA FAB ──────────────────────────────────── -->
  <a href="https://wa.link/o0a5u0" target="_blank" class="wa-fab">
    <i class="fa-brands fa-whatsapp"></i>
    <span class="wa-fab-tooltip">Chat on WhatsApp</span>
  </a>

  <script src="catalogue-ui.js"></script>
  <script src="product-modal.js?v=38"></script>
  <script>
    // ──────────────────────────────────────────────
    //  CONFIG — replace with your Lambda Function URL
    // ──────────────────────────────────────────────
    const LAMBDA_URL = 'https://j1yound90m.execute-api.ap-southeast-1.amazonaws.com';
    // NOTE: index.html uses Cloudflare Turnstile (see .cf-turnstile div above),
    // not Google reCAPTCHA. Turnstile auto-renders from the data-sitekey div;
    // getTurnstileToken() is defined in portal-polyfills.js (shared with portal.html).

    // ──────────────────────────────────────────────
    //  DEFAULT PRODUCTS (shown if Lambda catalogue empty)
    // ──────────────────────────────────────────────
    const DEFAULT_PRODUCTS = [
      { product_id: 'teja_lal_mirch', product_name: 'Teja Lal Mirch', category_name: 'Spices', description: 'Premium-grade Teja chilli with high heat (SHU). A favourite export to the Middle East and Southeast Asia.', icon: 'fa-solid fa-pepper-hot', min_order_kg: 25, available_stock: 'In Stock', price_per_kg: '' },
      { product_id: 'kashmiri_mirch', product_name: 'Kashmiri Mirch', category_name: 'Spices', description: 'Deep red colour with mild heat. Prized worldwide for the vibrant colour it adds to curry powder blends.', icon: 'fa-solid fa-pepper-hot', min_order_kg: 25, available_stock: 'In Stock', price_per_kg: '' },
      { product_id: 'haldi', product_name: 'Haldi (Turmeric)', category_name: 'Spices', description: 'High curcumin content with a bright golden colour. Export-certified and supplied with quality test reports.', icon: 'fa-solid fa-mortar-pestle', min_order_kg: 25, available_stock: 'In Stock', price_per_kg: '' },
      { product_id: 'jeera', product_name: 'Jeera (Cumin)', category_name: 'Spices', description: 'Premium cumin seeds — machine-cleaned, sortex-processed, and ready for export.', icon: 'fa-solid fa-seedling', min_order_kg: 10, available_stock: 'In Stock', price_per_kg: '' },
      { product_id: 'basmati_rice_1121', product_name: 'Basmati Rice 1121', category_name: 'Grains', description: 'Premium long-grain Basmati 1121 — aged, low broken, and exported to the Middle East and Europe.', icon: 'fa-solid fa-wheat-awn', min_order_kg: 50, available_stock: 'In Stock', price_per_kg: '' },
      { product_id: 'wheat', product_name: 'Wheat', category_name: 'Grains', description: 'High-protein Indian wheat — milling grade, suitable for flour production and bulk export.', icon: 'fa-solid fa-wheat-awn', min_order_kg: 1000, available_stock: 'Seasonal', price_per_kg: '' },
      { product_id: 'soybean', product_name: 'Soybean', category_name: 'Grains', description: 'Oil-content-grade soybean from Central India — suitable for oil extraction and animal feed.', icon: 'fa-solid fa-seedling', min_order_kg: 500, available_stock: 'In Stock', price_per_kg: '' },
      { product_id: 'onion', product_name: 'Onion', category_name: 'Vegetables', description: 'Fresh red onion of Maharashtra origin. A popular export to Bangladesh, Sri Lanka, and Malaysia.', icon: 'fa-solid fa-layer-group', min_order_kg: 100, available_stock: 'Seasonal', price_per_kg: '' },
      { product_id: 'garlic', product_name: 'Garlic', category_name: 'Vegetables', description: 'Fresh garlic bulbs — strong aroma and high allicin. Available in multiple grades.', icon: 'fa-solid fa-bahai', min_order_kg: 50, available_stock: 'In Stock', price_per_kg: '' },
      { product_id: 'sesame', product_name: 'Sesame Seeds', category_name: 'Seeds', description: 'Natural white sesame seeds — sortex-clean, low FFA, packed in 25 kg / 50 kg bags for export.', icon: 'fa-solid fa-seedling', min_order_kg: 25, available_stock: 'In Stock', price_per_kg: '' },
    ];

    // ──────────────────────────────────────────────
    //  NAV SCROLL
    // ──────────────────────────────────────────────
    window.addEventListener('scroll', () => {
      document.getElementById('mainNav').classList.toggle('scrolled', window.scrollY > 40);
    });

    // ──────────────────────────────────────────────
    //  MOBILE MENU
    // ──────────────────────────────────────────────
    document.getElementById('navToggle').addEventListener('click', () => {
      const m = document.getElementById('mobileMenu');
      const icon = document.getElementById('navToggleIcon');
      m.classList.toggle('open');
      icon.className = m.classList.contains('open') ? 'fa-solid fa-xmark' : 'fa-solid fa-bars';
    });
    function closeMobile() {
      document.getElementById('mobileMenu').classList.remove('open');
      document.getElementById('navToggleIcon').className = 'fa-solid fa-bars';
    }

    // ──────────────────────────────────────────────
    //  TOAST
    //  Thin wrapper kept so every existing toast(msg, type) call site
    //  below needs no rename. Delegates to the shared queued
    //  showToast() (catalogue-ui.js -> #toast host, components.css) —
    //  see Phase 3 notes on the removed legacy #toastContainer system.
    // ──────────────────────────────────────────────
    function toast(msg, type = 'success') {
      if (typeof window.showToast === 'function') {
        window.showToast(msg, type);
      }
    }

    // ──────────────────────────────────────────────
    //  FETCH CATALOGUE FROM LAMBDA
    // ──────────────────────────────────────────────
    let catalogueProducts = [];
    let selectedModalProduct = null;
    let activeCategoryFilter = 'All';
    let activeRatingFilter = 0;
    let searchDebounce = null;

    function renderStarRating(avg) {
      const n = parseFloat(avg) || 0;
      if (!n) {
        // §0-5: zero/no reviews yet — an empty 5-star row reads as "rated zero",
        // which is worse than showing nothing. Show only the New badge, no stars.
        return `<div class="product-card-rating"><span class="rating-count rating-count-new">New</span></div>`;
      }
      // Same rounded SVG stars as the portal grid (see .ax-star in
      // catalogue-ui.css) — kept in sync so both catalogues read identically.
      const filled = Math.round(Math.min(5, Math.max(0, n)));
      let stars = '';
      for (let i = 0; i < 5; i++) {
        stars += '<svg class="ax-star' + (i < filled ? ' filled' : '') + '" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.8l2.44 4.95 5.46.79-3.95 3.85.93 5.44L12 16.26l-4.88 2.57.93-5.44-3.95-3.85 5.46-.79z"/></svg>';
      }
      return `<div class="product-card-rating"><span class="rating-stars rating-stars-svg">${stars}</span><span class="rating-count">${n.toFixed(1)}</span></div>`;
    }

    /* ── Wishlist / heart button — same localStorage-backed pattern as
       portal.html's toggleProductLike/isProductLiked, ported here so the
       public catalogue has visual + functional parity. Index.html has no
       logged-in `currentUser`, so guest likes are scoped to a shared guest
       key (same key portal.html itself falls back to when signed out). ── */
    function likedProductsKey() { return 'ax_liked_products_guest'; }
    function getLikedProducts() {
      try { return JSON.parse(localStorage.getItem(likedProductsKey()) || '[]'); } catch (e) { return []; }
    }
    function isProductLiked(key) { return getLikedProducts().indexOf(key) !== -1; }
    function toggleProductLike(ev, key, btn) {
      if (ev) ev.stopPropagation();
      let liked = getLikedProducts();
      const i = liked.indexOf(key);
      let nowLiked;
      if (i === -1) { liked.push(key); nowLiked = true; }
      else { liked.splice(i, 1); nowLiked = false; }
      localStorage.setItem(likedProductsKey(), JSON.stringify(liked));
      if (btn) {
        btn.classList.toggle('liked', nowLiked);
        const icon = btn.querySelector('i');
        if (icon) icon.className = (nowLiked ? 'fa-solid' : 'fa-regular') + ' fa-heart';
      }
    }

    function buildCategoryChips(products) {
      const cats = ['All', ...new Set(products.map(p => p.category_name).filter(Boolean))];
      const dropdown = document.getElementById('categoryChips');
      const topRow = document.getElementById('catalogueChips');
      const dropdownHtml = cats.map(c => {
        const value = c === 'All' ? 'all' : c.replace(/"/g, '&quot;');
        return `<button class="filter-pill cat-chip${c === activeCategoryFilter ? ' active' : ''}" data-cat="${value}" type="button">${c}</button>`;
      }).join('');
      const topHtml = cats.map(c => {
        const value = c === 'All' ? 'all' : c.replace(/"/g, '&quot;');
        const icon = categoryIcon(c);
        return `<button class="catalogue-chip${c === activeCategoryFilter ? ' active' : ''}" data-cat="${value}" type="button"><span class="cat-icon-circle"><i class="${icon}"></i></span><span class="chip-label">${c}</span></button>`;
      }).join('');
      if (dropdown) dropdown.innerHTML = dropdownHtml;
      if (topRow) topRow.innerHTML = topHtml;
    }

    function updateFilterBadge() {
      const badge = document.getElementById('filterActiveBadge');
      if (!badge) return;
      const activeCount = (activeCategoryFilter && activeCategoryFilter !== 'All' ? 1 : 0) + (activeRatingFilter > 0 ? 1 : 0);
      badge.textContent = activeCount || '';
      badge.classList.toggle('show', !!activeCount);
    }

    function setCategoryFilter(cat, btn) {
      activeCategoryFilter = cat;
      document.querySelectorAll('#categoryChips .cat-chip').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('#catalogueChips .catalogue-chip').forEach(b => b.classList.remove('active'));
      if (btn) btn.classList.add('active');
      updateFilterBadge();
      applyCatalogueFilters();
    }

    function setRatingFilter(minStars, btn) {
      activeRatingFilter = minStars;
      document.querySelectorAll('#ratingChips .cat-chip').forEach(b => b.classList.remove('active'));
      if (btn) btn.classList.add('active');
      updateFilterBadge();
      applyCatalogueFilters();
    }

    function clearCatalogueFilters() {
      activeCategoryFilter = 'All';
      activeRatingFilter = 0;
      const search = document.getElementById('catalogueSearch');
      if (search) search.value = '';
      const clear = document.getElementById('searchClear');
      if (clear) clear.classList.remove('show');
      buildCategoryChips(catalogueProducts);
      document.querySelectorAll('#ratingChips .cat-chip').forEach((b, i) => b.classList.toggle('active', i === 0));
      updateFilterBadge();
      applyCatalogueFilters();
    }

    function applyCatalogueFilters() {
      const q = (document.getElementById('catalogueSearch')?.value || '').trim().toLowerCase();
      const clearBtn = document.getElementById('searchClear');
      if (clearBtn) clearBtn.classList.toggle('show', !!q);
      let list = catalogueProducts.slice();
      if (activeCategoryFilter && activeCategoryFilter !== 'All') {
        list = list.filter(p => p.category_name === activeCategoryFilter);
      } else if (typeof CatalogueUI !== 'undefined') {
        const st = CatalogueUI.getFilterState('filterDropdown');
        if (st.category && st.category !== 'all') list = list.filter(p => p.category_name === st.category);
      }
      if (typeof CatalogueUI !== 'undefined') {
        const st = CatalogueUI.getFilterState('filterDropdown');
        if (st.rating === '5') list = list.filter(p => (parseFloat(p.avg_rating) || 0) >= 4.75);
        else if (st.rating === '4') list = list.filter(p => (parseFloat(p.avg_rating) || 0) >= 4);
        else if (st.rating === '3') list = list.filter(p => (parseFloat(p.avg_rating) || 0) >= 3);
      } else if (activeRatingFilter > 0) {
        list = list.filter(p => (parseFloat(p.avg_rating) || 0) >= activeRatingFilter);
      }
      if (q) {
        if (typeof ProductModal !== 'undefined' && ProductModal.searchShop(q)) {
          return;
        }
        list = list.filter(p =>
          (p.product_name || '').toLowerCase().includes(q) ||
          (p.category_name || '').toLowerCase().includes(q) ||
          (p.shop_name || '').toLowerCase().includes(q) ||
          (p.description || '').toLowerCase().includes(q)
        );
      }
      renderProducts(list);
    }

    document.getElementById('catalogueSearch')?.addEventListener('input', () => {
      clearTimeout(searchDebounce);
      searchDebounce = setTimeout(applyCatalogueFilters, 300);
    });

    async function loadCatalogue() {
      const grid = document.getElementById('productsGrid');
      if (grid) {
        grid.innerHTML = Array(6).fill(0).map(function () {
          return '<div class="product-card" style="pointer-events:none;opacity:.85">' +
            '<div class="skeleton" style="width:100%;aspect-ratio:4/3;border-radius:0"></div>' +
            '<div class="product-card-body" style="padding:18px">' +
            '<div class="skeleton" style="height:10px;width:55%;margin-bottom:8px"></div>' +
            '<div class="skeleton" style="height:16px;width:80%;margin-bottom:10px"></div>' +
            '<div class="skeleton" style="height:32px;width:100%;border-radius:8px"></div>' +
            '</div></div>';
        }).join('');
      }
      let source = 'live';
      try {
        const res = await fetch(`${LAMBDA_URL}/catalogue`, {
          method: 'GET',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          signal: typeof AbortSignal !== 'undefined' && AbortSignal.timeout ? AbortSignal.timeout(12000) : undefined
        });
        if (res.ok) {
          const data = typeof safeFetchJson === 'function' ? await safeFetchJson(res) : await res.json();
          const products = data.products || data.items || [];
          if (products.length > 0) {
            catalogueProducts = products;
            buildCategoryChips(products);
            applyCatalogueFilters();
            return;
          }
          source = 'empty';
        } else {
          source = 'error';
        }
      } catch (e) {
        source = 'offline';
      }
      catalogueProducts = source === 'offline' || source === 'error' ? DEFAULT_PRODUCTS : [];
      if (catalogueProducts.length) {
        buildCategoryChips(catalogueProducts);
        applyCatalogueFilters();
        if (source !== 'live') {
          const badge = document.getElementById('catalogueLiveBadge');
          if (badge) {
            badge.innerHTML = source === 'offline'
              ? '<i class="fa-solid fa-wifi-slash"></i> Offline preview — <a href="javascript:loadCatalogue()" style="color:inherit;font-weight:700">Retry live</a>'
              : '<i class="fa-solid fa-seedling"></i> Sample catalogue — add products in Admin';
            badge.style.display = '';
          }
        }
        return;
      }
      if (grid) {
        grid.innerHTML = `<div class="products-empty">
      <i class="fa-solid fa-store"></i>
      <h3>Products coming soon</h3>
      <p>Sellers are onboarding. Check back shortly or contact us on WhatsApp for the full export catalogue.</p>
      <button class="btn-primary" type="button" onclick="loadCatalogue()" style="margin-top:16px"><i class="fa-solid fa-rotate"></i> Refresh</button>
    </div>`;
      }
    }

    const PRODUCT_ICONS = {
      mirch: 'fa-solid fa-pepper-hot', chilli: 'fa-solid fa-pepper-hot', pepper: 'fa-solid fa-pepper-hot',
      haldi: 'fa-solid fa-mortar-pestle', turmeric: 'fa-solid fa-mortar-pestle',
      jeera: 'fa-solid fa-seedling', cumin: 'fa-solid fa-seedling', sesame: 'fa-solid fa-seedling', seed: 'fa-solid fa-seedling',
      rice: 'fa-solid fa-wheat-awn', wheat: 'fa-solid fa-wheat-awn', grain: 'fa-solid fa-wheat-awn',
      soybean: 'fa-solid fa-seedling', bean: 'fa-solid fa-seedling',
      onion: 'fa-solid fa-layer-group',
      garlic: 'fa-solid fa-bahai',
    };
    const CATEGORY_ICONS = {
      All: 'fa-solid fa-border-all',
      Spices: 'fa-solid fa-pepper-hot',
      Grains: 'fa-solid fa-wheat-awn',
      Vegetables: 'fa-solid fa-bowl-food',
      Seeds: 'fa-solid fa-seedling',
      Oils: 'fa-solid fa-droplet',
      Default: 'fa-solid fa-leaf',
    };
    function categoryIcon(name) {
      return CATEGORY_ICONS[name] || CATEGORY_ICONS.Default;
    }
    function getProductIcon(p) {
      if (p && typeof p === 'object' && p.icon) return p.icon;
      const name = typeof p === 'string' ? p : (p && p.product_name) || '';
      const n = name.toLowerCase();
      for (const [k, v] of Object.entries(PRODUCT_ICONS)) {
        if (n.includes(k)) return v;
      }
      return 'fa-solid fa-leaf';
    }

    function renderProducts(products) {
      const grid = document.getElementById('productsGrid');
      if (!products || !products.length) {
        grid.innerHTML = `<div class="products-empty">
      <i class="fa-solid fa-seedling"></i>
      <h3>Catalogue Loading…</h3>
      <p>Products will appear once configured in the admin panel. Reach us on WhatsApp for the full list.</p>
    </div>`;
        return;
      }
      grid.innerHTML = products.map((p, idx) => {
        const icon = getProductIcon(p);
        const hasImg = p.image_url && p.image_url.length > 10;
        const disc = typeof CatalogueUI !== 'undefined' ? CatalogueUI.priceDiscountInfo(p) : { show: false, mrpHtml: '', badgeHtml: '' };
        const price = p.lot_price && p.lot_size_kg
          ? `₹${p.lot_price}<small> / lot (${p.lot_size_kg} kg)</small>`
          : (p.price_per_kg ? `₹${p.price_per_kg}<small>/kg</small>` : `<small style="color:var(--text3);font-size:13px">Contact for price</small>`);
        const paused = p.is_paused || (p.available_stock || '').toLowerCase().includes('out');
        const pausedLabel = p.is_paused ? 'Paused' : ((p.available_stock || '').toLowerCase().includes('out') ? 'Out of Stock' : '');
        const shopLine = p.shop_name ? `<div class="shop-badge"><i class="fa-solid fa-store"></i> ${p.shop_name}</div>` : '';
        const ratingLine = renderStarRating(p.avg_rating);
        const likeKey = (p.shop_id || '') + '::' + (p.product_id || idx);
        const isLiked = isProductLiked(likeKey);
        const stockLc = (p.available_stock || '').toLowerCase();
        const stockColor = stockLc.includes('out') ? 'var(--color-feedback-error)' : (stockLc.includes('low') || stockLc.includes('few') ? 'var(--color-feedback-error)' : 'var(--color-feedback-success)');
        return `
    <div class="product-card reveal${paused ? ' paused-card' : ''}" onclick="openProductModalById('${(p.product_id || '').replace(/'/g, "\\'")}','${(p.category_id || '').replace(/'/g, "\\'")}')" style="cursor:pointer;position:relative">
      ${pausedLabel ? `<span class="paused-label">${pausedLabel}</span>` : ''}
      <div class="product-card-img">
        ${hasImg ? `<img src="${p.image_url}" alt="${p.product_name}" loading="lazy" onerror="this.onerror=null;this.style.display='none';this.nextElementSibling.style.display='grid'">` : ''}
        <div class="img-fallback" style="${hasImg ? 'display:none' : ''}">
          <i class="${icon}"></i>
        </div>
        <button type="button" class="product-card-like-btn${isLiked ? ' liked' : ''}" onclick="toggleProductLike(event,'${likeKey}',this)"><i class="${isLiked ? 'fa-solid' : 'fa-regular'} fa-heart"></i></button>
      </div>
      <div class="product-card-body">
        ${ratingLine}
        <div class="product-card-category">${p.category_name || 'Agricultural Product'}</div>
        <div class="product-card-name">${p.product_name}</div>
        ${shopLine}
        ${typeof CatalogueUI !== 'undefined' ? CatalogueUI.descHtml(p.description || 'Premium quality agricultural product from Aarvex Global. Export grade, certified documentation.', 120) : `<div class="product-card-desc">${p.description || 'Premium quality agricultural product from Aarvex Global.'}</div>`}
        <div class="product-card-meta">
          <span class="tag"><i class="fa-solid fa-weight-hanging" style="font-size:10px"></i> Min ${p.min_order_kg || 1} kg</span>
        </div>
        <div class="product-card-footer">
          <div class="product-card-price-info">
            <div class="product-card-price-wrap">
              <div class="product-price">${price}</div>
              ${disc.mrpHtml}
            </div>
            ${disc.badgeHtml}
            <div class="product-card-stock-pill"><i class="fa-solid fa-circle" style="color:${stockColor}"></i> ${p.available_stock || 'In Stock'}</div>
          </div>
          <button class="product-order-btn" onclick="event.stopPropagation();openProductModalById('${(p.product_id || '').replace(/'/g, "\\'")}','${(p.category_id || '').replace(/'/g, "\\'")}')">
            <i class="fa-solid fa-cart-plus"></i> Order
          </button>
        </div>
      </div>
    </div>`;
      }).join('');
      observeReveals(grid);
    }


    // ──────────────────────────────────────────────
    //  PRODUCT MODAL
    // ──────────────────────────────────────────────
    function openProductModalById(productId, categoryId) {
      var p = catalogueProducts.find(function (x) {
        return x.product_id === productId && (!categoryId || x.category_id === categoryId);
      });
      if (!p) return;
      var q = 'product=' + encodeURIComponent(p.product_id || '') + '&category=' + encodeURIComponent(p.category_id || '');
      window.location.href = 'portal.html?' + q;
    }







    // ──────────────────────────────────────────────
    //  SUBMIT SELL FORM
    // ──────────────────────────────────────────────
    async function submitSellForm() {
      const errBox = document.getElementById('sellError');
      errBox.classList.remove('show');

      const payload = {
        contact_name: document.getElementById('sell_name').value.trim(),
        mobile: document.getElementById('sell_mobile').value.trim(),
        email: document.getElementById('sell_email').value.trim(),
        crop: document.getElementById('sell_crop').value.trim(),
        quantity_available_kg: parseFloat(document.getElementById('sell_qty').value) || 0,
        expected_price: document.getElementById('sell_price').value.trim() || undefined,
        location_city: document.getElementById('sell_city').value.trim(),
        location_state: document.getElementById('sell_state').value.trim(),
        pincode: document.getElementById('sell_pincode').value.trim(),
      };

      const missing = [];
      if (!payload.contact_name) missing.push('Name');
      if (!payload.mobile) missing.push('Mobile');
      if (!payload.crop) missing.push('Crop');
      if (!payload.quantity_available_kg) missing.push('Quantity');
      if (!payload.location_city) missing.push('City');
      if (!payload.location_state) missing.push('State');
      if (missing.length) {
        errBox.textContent = 'Please fill: ' + missing.join(', ');
        errBox.classList.add('show');
        return;
      }

      const recaptchaToken = typeof getTurnstileToken === 'function' ? getTurnstileToken('sellRecaptcha') : '';
      if (!recaptchaToken) {
        errBox.textContent = 'Please complete the captcha verification.';
        errBox.classList.add('show');
        return;
      }
      payload.recaptcha_token = recaptchaToken;

      const btn = document.getElementById('sellSubmitBtn');
      btn.disabled = true;
      btn.innerHTML = '<div class="spinner"></div> Submitting…';

      try {
        const res = await fetch(`${LAMBDA_URL}/web/sell`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = typeof safeFetchJson === 'function' ? await safeFetchJson(res) : await res.json();
        if (res.ok && data.success) {
          document.getElementById('sellFormContent').style.display = 'none';
          const succ = document.getElementById('sellSuccess');
          succ.classList.add('show');
          document.getElementById('sellRefId').textContent = data.reference_id ? `Reference ID: ${data.reference_id}` : '';
          toast('Listing submitted! Our team will contact you on WhatsApp.');
        } else {
          errBox.textContent = data.error || 'Something went wrong. Please try again.';
          errBox.classList.add('show');
          if (typeof turnstile !== 'undefined') turnstile.reset('#sellRecaptcha');
        }
      } catch (e) {
        errBox.textContent = 'Network error. Please try again or contact us on WhatsApp.';
        errBox.classList.add('show');
        if (typeof turnstile !== 'undefined') turnstile.reset('#sellRecaptcha');
      }

      btn.disabled = false;
      btn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Submit Listing';
    }


    // ──────────────────────────────────────────────
    //  SCROLL REVEAL
    // ──────────────────────────────────────────────
    function setupReveal() {
      const selectors = [
        '.products-header',
        '.why-content', '.cred-card',
        '.sell-info', '.sell-form-box',
        '.about-content', '.social-link-card',
        '.footer-grid > div'
      ];
      const els = new Set();
      selectors.forEach(sel => document.querySelectorAll(sel).forEach(el => els.add(el)));
      els.forEach(el => el.classList.add('reveal'));

      const io = new IntersectionObserver((entries, obs) => {
        entries.forEach(en => {
          if (en.isIntersecting) { en.target.classList.add('in'); obs.unobserve(en.target); }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });

      document.querySelectorAll('.reveal').forEach(el => io.observe(el));
      window.__revealObserver = io;
    }

    // Re-observe dynamically rendered product cards
    function observeReveals(scope) {
      if (!window.__revealObserver) return;
      (scope || document).querySelectorAll('.reveal:not(.in)').forEach(el => window.__revealObserver.observe(el));
    }

    // ──────────────────────────────────────────────
    //  LOGIN STATE CHECK
    //  Agar user pehle se logged in hai toh seedha
    //  portal.html pe redirect kar do
    // ──────────────────────────────────────────────
    (function checkLoginState() {
      try {
        const saved = localStorage.getItem('ax_user');
        if (!saved) return;
        const user = JSON.parse(saved);

        // Nav buttons → "My Account"
        const btn = document.getElementById('navLoginBtn');
        const mBtn = document.getElementById('mobileLoginBtn');
        const firstName = (user.name || 'User').split(' ')[0];
        if (btn) {
          if (typeof CatalogueUI !== 'undefined') {
            // .nav-user-avatar keeps the existing leaf-colored border ring;
            // avatarInitialsHtml() supplies the sizing/fallback/onerror behavior.
            const avatarHtml = CatalogueUI.avatarInitialsHtml(user, 26).replace('avatar-initials-fallback', 'avatar-initials-fallback nav-user-avatar');
            btn.innerHTML = `${avatarHtml} ${firstName}`;
          } else if (user.picture) {
            btn.innerHTML = `<img class="nav-user-avatar" src="${user.picture}" alt=""> ${firstName}`;
          } else {
            btn.innerHTML = `<i class="fa-solid fa-circle-user"></i> ${firstName}`;
          }
          btn.classList.add('logged-in');
          btn.href = 'portal.html';
        }
        if (mBtn) {
          if (typeof CatalogueUI !== 'undefined') {
            mBtn.innerHTML = `${CatalogueUI.avatarInitialsHtml(user, 22)} My Account`;
          } else {
            mBtn.innerHTML = user.picture
              ? `<img src="${user.picture}" style="width:22px;height:22px;border-radius:50%;vertical-align:middle"> My Account`
              : `<i class="fa-solid fa-circle-user" style="color:var(--leaf)"></i> My Account — ${firstName}`;
          }
        }

        // Pre-fill Order & Sell forms with portal login data
        function prefillForms() {
          const set = (id, val) => {
            if (!val) return;
            const el = document.getElementById(id);
            if (el && !el.value) el.value = val;
          };
          // Sell form
          set('sell_name', user.name);
          set('sell_email', user.email);
          set('sell_mobile', user.phone || user.mobile || '');
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', prefillForms);
        } else {
          prefillForms();
        }
      } catch (e) {
        localStorage.removeItem('ax_user');
      }
    })();

    // ──────────────────────────────────────────────
    //  TOP SHOPS LEADERBOARD
    // ──────────────────────────────────────────────
    async function loadTopShops() {
      const loading = document.getElementById('topShopsLoading');
      const empty = document.getElementById('topShopsEmpty');
      const container = document.getElementById('topShopsContainer');
      const featured = document.getElementById('topShopFeatured');
      const list = document.getElementById('topShopsList');

      try {
        const res = await fetch(`${LAMBDA_URL}/shops/top`);
        const data = await res.json();

        loading.style.display = 'none';

        if (!data.shops || data.shops.length === 0) {
          empty.style.display = 'block';
          return;
        }

        container.style.display = 'block';
        const shops = data.shops;

        // Render featured #1 shop
        if (shops.length > 0) {
          const topShop = shops[0];
          featured.innerHTML = `
        <div class="top-shop-featured" onclick="navigateToShop('${topShop.shop_id}')">
          <div class="top-shop-featured-badge">★ Star Performer</div>
          <div class="top-shop-featured-icon">
            <i class="fa-solid fa-store"></i>
          </div>
          <div class="top-shop-featured-info">
            <div class="top-shop-featured-name">${escapeHtml(topShop.shop_name || 'Unnamed Shop')}</div>
            <div class="top-shop-featured-meta">
              <div class="top-shop-rating">
                <i class="fa-solid fa-star"></i> ${topShop.avg_rating || 0}
              </div>
              <div class="top-shop-reviews">${topShop.total_reviews || 0} reviews</div>
              <div class="top-shop-likes">
                <i class="fa-solid fa-heart"></i> ${topShop.like_count || 0}
              </div>
            </div>
          </div>
          <button class="top-shop-like-btn" onclick="event.stopPropagation(); likeShop('${topShop.shop_id}', this)">
            <i class="fa-solid fa-heart"></i> Like
          </button>
        </div>
      `;
        }

        // Render shops #2-10
        if (shops.length > 1) {
          const remainingShops = shops.slice(1);
          list.innerHTML = remainingShops.map((shop, index) => `
        <div class="top-shop-card" onclick="navigateToShop('${shop.shop_id}')">
          <div class="top-shop-rank">#${index + 2}</div>
          <div class="top-shop-card-icon">
            <i class="fa-solid fa-store"></i>
          </div>
          <div class="top-shop-card-info">
            <div class="top-shop-card-name">${escapeHtml(shop.shop_name || 'Unnamed Shop')}</div>
            <div class="top-shop-card-meta">
              <span><i class="fa-solid fa-star" style="color:var(--c-gold)"></i> ${shop.avg_rating || 0}</span>
              <span>${shop.total_reviews || 0} reviews</span>
              <span><i class="fa-solid fa-heart" style="color:#E1435A"></i> ${shop.like_count || 0}</span>
            </div>
          </div>
          <button class="top-shop-card-like-btn" onclick="event.stopPropagation(); likeShop('${shop.shop_id}', this)">
            <i class="fa-solid fa-heart"></i>
          </button>
        </div>
      `).join('');
        }

        // Setup toggle
        const toggle = document.getElementById('topShopsToggle');
        const content = document.getElementById('topShopsContent');
        const icon = document.getElementById('topShopsToggleIcon');
        const text = document.getElementById('topShopsToggleText');

        toggle.addEventListener('click', () => {
          const isExpanded = content.classList.toggle('expanded');
          icon.className = isExpanded ? 'fa-solid fa-chevron-up' : 'fa-solid fa-chevron-down';
          text.textContent = isExpanded ? 'Show less' : 'View all top shops';
          toggle.setAttribute('aria-expanded', isExpanded);
        });

      } catch (e) {
        console.error('Failed to load top shops:', e);
        loading.style.display = 'none';
        empty.style.display = 'block';
      }
    }

    function navigateToShop(shopId) {
      // Navigate to shop's public storefront
      // For now, redirect to trade hub with shop filter
      window.location.href = `portal.html?shop=${encodeURIComponent(shopId)}`;
    }

    async function likeShop(shopId, btn) {
      const user = localStorage.getItem('ax_user');
      if (!user) {
        toast('Please login to like shops');
        window.location.href = 'portal.html';
        return;
      }

      try {
        const res = await fetch(`${LAMBDA_URL}/shop/like`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ shop_id: shopId })
        });
        const data = await res.json();

        if (data.success) {
          btn.classList.add('liked');
          const icon = btn.querySelector('i');
          if (icon) icon.classList.add('fa-solid');
          icon.classList.remove('fa-regular');

          // Update like count display
          const likesDisplay = btn.parentElement.querySelector('.top-shop-likes, .top-shop-card-meta span:last-child');
          if (likesDisplay) {
            const currentCount = parseInt(likesDisplay.textContent.replace(/\D/g, '')) || 0;
            likesDisplay.innerHTML = `<i class="fa-solid fa-heart" style="color:#E1435A"></i> ${data.like_count}`;
          }

          if (!data.already_liked) {
            toast('Shop liked!');
          }
        }
      } catch (e) {
        console.error('Failed to like shop:', e);
        toast('Failed to like shop. Please try again.');
      }
    }

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    // ──────────────────────────────────────────────
    //  INIT
    // ──────────────────────────────────────────────
    setupReveal();
    loadCatalogue();
    loadTopShops();
  </script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      if (typeof CatalogueUI !== 'undefined') {
        CatalogueUI.initFilterDropdown({ onFilter: applyCatalogueFilters, onSearch: applyCatalogueFilters });
        document.getElementById('filterDropdown')?.addEventListener('click', function (e) {
          var chip = e.target.closest('#categoryChips .cat-chip');
          if (chip) {
            activeCategoryFilter = chip.getAttribute('data-cat') === 'all' ? 'All' : chip.getAttribute('data-cat');
            applyCatalogueFilters();
          }
        });
        document.getElementById('catalogueChips')?.addEventListener('click', function (e) {
          var chip = e.target.closest('.catalogue-chip');
          if (!chip) return;
          activeCategoryFilter = chip.getAttribute('data-cat') === 'all' ? 'All' : chip.getAttribute('data-cat');
          document.querySelectorAll('#catalogueChips .catalogue-chip').forEach(function (el) { el.classList.remove('active'); });
          chip.classList.add('active');
          document.querySelectorAll('#categoryChips .cat-chip').forEach(function (el) { el.classList.remove('active'); });
          var matching = document.querySelector('#categoryChips .cat-chip[data-cat="' + chip.getAttribute('data-cat') + '"]');
          if (matching) matching.classList.add('active');
          updateFilterBadge();
          applyCatalogueFilters();
        });
      }

      /* On index: product card click → open pd-modal; "Order" button → portal.html */
      if (typeof ProductModal !== 'undefined') {
        var _origOpen = ProductModal.openModal;
        ProductModal.openModal = function (product) {
          window._indexProduct = product;
          _origOpen(product);
          /* Override the action button rendered by renderActions */
          var wrap = document.getElementById('pdModalActions');
          if (wrap) {
            wrap.innerHTML =
              '<button type="button" class="pd-btn-buy" onclick="indexGoToPortal()">' +
              '<i class="fa-solid fa-cart-shopping"></i> Order This Product</button>' +
              '<p class="pd-action-note"><i class="fa-solid fa-user-lock"></i> Complete your order securely in your account portal.</p>';
          }
        };
        /* Also override openProductModalById to use new modal */
        window.openProductModalById = function (productId, categoryId) {
          var p = catalogueProducts.find(function (x) {
            return x.product_id === productId && (!categoryId || x.category_id === categoryId);
          });
          if (p) ProductModal.openModal(p);
        };
      }
    });

    function indexGoToPortal() {
      var p = window._indexProduct;
      if (typeof ProductModal !== 'undefined') ProductModal.closeModal();
      if (p) {
        var q = 'product=' + encodeURIComponent(p.product_id || '') + '&category=' + encodeURIComponent(p.category_id || '') + '&action=order';
        window.location.href = 'portal.html?' + q;
      } else {
        window.location.href = 'portal.html';
      }
    }
  </script>
</body>

</html>
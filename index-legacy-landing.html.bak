  <!-- ── SELL YOUR PRODUCE ───────────────────────── -->
  <section class="sell-section" id="sell">
    <div class="container">
      <div class="sell-grid">
        <div class="sell-info">
          <div class="eyebrow"><i class="fa-solid fa-tractor"></i> For Farmers & Exporters</div>
          <h2 class="section-title">Sell Your<br>Produce to Us</h2>
          <p>Are you a farmer, FPO, or produce aggregator? Register your crop with us and our team will contact you with
            a price quote within 24 hours.</p>
          <div class="sell-steps">
            <div class="sell-step">
              <div class="sell-step-num">1</div>
              <div class="sell-step-text">
                <h4>Fill the Form</h4>
                <p>Tell us about your crop, quantity available, and expected price.</p>
              </div>
            </div>
            <div class="sell-step">
              <div class="sell-step-num">2</div>
              <div class="sell-step-text">
                <h4>Team Contact</h4>
                <p>Our team will call you within 24 hours with a competitive offer.</p>
              </div>
            </div>
            <div class="sell-step">
              <div class="sell-step-num">3</div>
              <div class="sell-step-text">
                <h4>Payment & Pickup</h4>
                <p>Agree on price, we arrange logistics and payment directly.</p>
              </div>
            </div>
          </div>
        </div>
        <div class="sell-form-box">
          <h3>Register Your Crop</h3>
          <p>Fill in the details below and we'll reach out shortly.</p>
          <div id="sellFormContent">
            <div class="form-group">
              <label class="form-label">Your Name <span class="req">*</span></label>
              <input type="text" class="form-input" id="sell_name" placeholder="Full name">
            </div>
            <div class="form-group">
              <label class="form-label">Mobile Number <span class="req">*</span></label>
              <input type="tel" class="form-input" id="sell_mobile" placeholder="+91 or 10-digit number">
            </div>
            <div class="form-group">
              <label class="form-label">Email Address</label>
              <input type="email" class="form-input" id="sell_email" placeholder="Optional">
            </div>
            <div class="form-group">
              <label class="form-label">Crop / Product <span class="req">*</span></label>
              <input type="text" class="form-input" id="sell_crop" placeholder="e.g. Teja Mirch, Onion, Wheat…">
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Quantity (kg) <span class="req">*</span></label>
                <input type="number" class="form-input" id="sell_qty" placeholder="500" min="1">
              </div>
              <div class="form-group">
                <label class="form-label">Expected Price (₹/kg)</label>
                <input type="number" class="form-input" id="sell_price" placeholder="Optional">
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">City <span class="req">*</span></label>
                <input type="text" class="form-input" id="sell_city" placeholder="Nagpur">
              </div>
              <div class="form-group">
                <label class="form-label">State <span class="req">*</span></label>
                <input type="text" class="form-input" id="sell_state" placeholder="Maharashtra">
              </div>
            </div>
            <div class="form-group">
              <label class="form-label">Pincode</label>
              <input type="text" class="form-input" id="sell_pincode" placeholder="Optional">
            </div>
            <div class="api-error-msg" id="sellError"></div>
            <div class="recaptcha-wrap" style="margin:16px 0;display:flex;justify-content:flex-start">
              <div class="cf-turnstile" id="sellRecaptcha" data-sitekey="0x4AAAAAADs_xRz679e2-ggj"></div>
            </div>
            <button class="form-submit" id="sellSubmitBtn" onclick="submitSellForm()">
              <i class="fa-solid fa-paper-plane"></i> Submit Listing
            </button>
          </div>
          <div class="form-success" id="sellSuccess">
            <i class="fa-solid fa-circle-check"></i>
            <h3>Listing Submitted!</h3>
            <p>Our team will contact you on WhatsApp within 24 hours.</p>
            <p id="sellRefId" style="margin-top:10px; font-weight:600; color:var(--leaf); font-size:15px"></p>
          </div>
        </div>
      </div>
    </div>
  </section>


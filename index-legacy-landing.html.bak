            <a href="https://www.facebook.com/profile.php?id=61590539051710" target="_blank"><i
                class="fa-brands fa-facebook-f"></i></a>
            <a href="https://wa.link/o0a5u0" target="_blank"><i class="fa-brands fa-whatsapp"></i></a>

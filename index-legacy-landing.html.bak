            <li><a href="#products"><i class="fa-solid fa-pepper-hot"></i> Teja Lal Mirch</a></li>
            <li><a href="#products"><i class="fa-solid fa-pepper-hot"></i> Kashmiri Mirch</a></li>
            <li><a href="#products"><i class="fa-solid fa-leaf"></i> Haldi / Turmeric</a></li>

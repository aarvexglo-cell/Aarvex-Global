                class="fa-brands fa-linkedin-in"></i></a>
            <a href="https://x.com/aarvexglobal" target="_blank"><i class="fa-brands fa-x-twitter"></i></a>
            <a href="https://t.me/aarvexglobal_bot" target="_blank"><i class="fa-brands fa-telegram"></i></a>
